//Algoritmo QUE SOLICITE UN NUMERO ENTERO Y QUE MEDIANTE UNA FUNCION DEVUELVA LA RAIZ CUADRADA DE EL NUMERO

Funcion CalRaiz = CalcularRaiz(num)
	CalRaiz = Raiz(num)
FinFuncion

Algoritmo main
	Definir r Como Entero
	Escribir "ingresa un numero a sacar riaz"
	Leer r
	
	Imprimir CalcularRaiz(r)
FinAlgoritmo
	