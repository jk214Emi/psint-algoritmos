Algoritmo TresNumeros
	Definir Num1, Num2, Num3 Como Real
	Escribir "Ingresa el numero 1"
	Leer Num1
	Escribir "Ingresa el numero 2"
	Leer Num2
	Escribir "Ingresa el numero 3"
	Leer Num3
	si Num1 < 0 Entonces
		Imprimir (Num1*Num2*Num3)
	SiNo
		Imprimir (Num1+Num2+Num3)
	FinSi
FinAlgoritmo
