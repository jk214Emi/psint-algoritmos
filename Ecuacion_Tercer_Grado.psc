Algoritmo Ecuacion_Tercer_Grado
    // Definición
    Definir a, b, c, d, x, EcuacionY Como Real
	
    // Entradas
    Escribir "Cálculo de Ecuación de Tercer Grado"
    Escribir "Ingrese el coeficiente a:"
    Leer a
    Escribir "Ingrese el coeficiente b:"
    Leer b
    Escribir "Ingrese el coeficiente c:"
    Leer c
    Escribir "Ingrese el coeficiente d:"
    Leer d
    Escribir "Ingrese el valor de x:"
    Leer x
	
    // Proceso
    EcuacionY <- (a * x^3) + (b * x^2) + (c * x) + d
	
    // Salidas
    Escribir "El resultado de la ecuación evaluada es (y): ", EcuacionY
FinAlgoritmo